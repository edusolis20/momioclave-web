---
import { getCollection } from 'astro:content';
import BaseLayout from '../../layouts/BaseLayout.astro';
import NewsletterCapture from '../../components/home/NewsletterCapture.astro';
import { CLUSTERS } from '../../data/articulos';

export async function getStaticPaths() {
  const articulos = await getCollection('articulos');
  return articulos.map(articulo => ({
    params: { slug: articulo.slug },
    props: { articulo },
  }));
}

const { articulo } = Astro.props;
const { Content } = await articulo.render();
const cluster = CLUSTERS[articulo.data.cluster];

// Related articles (same cluster, excluding current)
const todos = await getCollection('articulos');
const relacionados = todos
  .filter(a => a.data.cluster === articulo.data.cluster && a.slug !== articulo.slug)
  .slice(0, 2);

function formatFecha(iso: string) {
  return new Date(iso + 'T12:00:00').toLocaleDateString('es-MX', {
    year: 'numeric', month: 'long', day: 'numeric',
  });
}
---

<BaseLayout
  title={articulo.data.titulo}
  description={articulo.data.descripcion}
>

  <div class="bg-white pt-10 pb-2 px-4 sm:px-6 lg:px-8">
    <div class="max-w-3xl mx-auto">

      <!-- Breadcrumb -->
      <nav class="flex items-center gap-2 text-xs text-gray-400 mb-8">
        <a href="/" class="hover:text-gray-600">Inicio</a>
        <span>/</span>
        <a href="/aprende" class="hover:text-gray-600">Aprende</a>
        <span>/</span>
        <span class="text-gray-600">{cluster.nombre}</span>
      </nav>

      <!-- Cluster badge -->
      <div class="inline-flex items-center gap-1.5 bg-gray-50 border border-gray-100 px-3 py-1.5 rounded-full text-xs font-semibold text-gray-700 mb-5">
        <span>{cluster.icono}</span>
        {cluster.nombre}
      </div>

      <!-- Title -->
      <h1 class="text-3xl sm:text-4xl font-extrabold text-gray-900 leading-tight mb-5">
        {articulo.data.titulo}
      </h1>

      <!-- Meta -->
      <div class="flex flex-wrap items-center gap-x-4 gap-y-1 text-sm text-gray-400 pb-8 border-b border-gray-100 mb-10">
        <span>{formatFecha(articulo.data.fecha)}</span>
        <span>·</span>
        <span>{articulo.data.tiempoLectura} min de lectura</span>
        <span>·</span>
        <span>Equipo MomiosMX</span>
      </div>
    </div>
  </div>

  <!-- Article body -->
  <div class="px-4 sm:px-6 lg:px-8 pb-16">
    <div class="max-w-3xl mx-auto">
      <div class="article-content">
        <Content />
      </div>

      <!-- Tags -->
      <div class="flex flex-wrap gap-2 mt-12 pt-8 border-t border-gray-100">
        <span class="px-3 py-1 bg-gray-50 text-gray-600 text-xs font-medium rounded-full">
          {cluster.nombre}
        </span>
        <span class="px-3 py-1 bg-gray-50 text-gray-600 text-xs font-medium rounded-full">
          Apuestas deportivas
        </span>
        <span class="px-3 py-1 bg-gray-50 text-gray-600 text-xs font-medium rounded-full">
          Liga MX
        </span>
      </div>
    </div>
  </div>

  <!-- Related articles -->
  {relacionados.length > 0 && (
    <section class="py-12 px-4 sm:px-6 lg:px-8 bg-gray-50 border-t border-gray-100">
      <div class="max-w-3xl mx-auto">
        <h2 class="text-lg font-bold text-gray-900 mb-6">Sigue aprendiendo</h2>
        <div class="grid grid-cols-1 sm:grid-cols-2 gap-4">
          {relacionados.map(rel => (
            <a
              href={`/aprende/${rel.slug}`}
              class="group bg-white border border-gray-100 rounded-xl p-5 hover:border-blue-200 hover:shadow-sm transition-all"
            >
              <div class="text-xs text-gray-400 mb-2">{CLUSTERS[rel.data.cluster].icono} {CLUSTERS[rel.data.cluster].nombre} · {rel.data.tiempoLectura} min</div>
              <h3 class="font-semibold text-gray-900 text-sm leading-snug group-hover:text-blue-900 transition-colors">
                {rel.data.titulo}
              </h3>
            </a>
          ))}
        </div>
      </div>
    </section>
  )}

  <!-- Newsletter CTA -->
  <NewsletterCapture />

</BaseLayout>

<style>
  .article-content :global(h2) {
    font-size: 1.375rem;
    font-weight: 700;
    color: #111827;
    margin-top: 2.5rem;
    margin-bottom: 0.75rem;
    line-height: 1.3;
  }
  .article-content :global(h3) {
    font-size: 1.125rem;
    font-weight: 600;
    color: #1e3a8a;
    margin-top: 1.75rem;
    margin-bottom: 0.5rem;
  }
  .article-content :global(p) {
    color: #374151;
    line-height: 1.8;
    margin-bottom: 1.25rem;
    font-size: 1.0625rem;
  }
  .article-content :global(strong) {
    font-weight: 600;
    color: #111827;
  }
  .article-content :global(ul), .article-content :global(ol) {
    margin-bottom: 1.25rem;
    padding-left: 1.5rem;
  }
  .article-content :global(li) {
    color: #374151;
    line-height: 1.7;
    margin-bottom: 0.4rem;
  }
  .article-content :global(table) {
    width: 100%;
    border-collapse: collapse;
    margin-bottom: 1.5rem;
    font-size: 0.9375rem;
  }
  .article-content :global(thead tr) {
    background-color: #f9fafb;
    border-bottom: 2px solid #e5e7eb;
  }
  .article-content :global(th) {
    text-align: left;
    padding: 0.625rem 1rem;
    font-weight: 600;
    font-size: 0.8125rem;
    color: #6b7280;
    text-transform: uppercase;
    letter-spacing: 0.03em;
  }
  .article-content :global(td) {
    padding: 0.625rem 1rem;
    color: #374151;
    border-bottom: 1px solid #f3f4f6;
  }
  .article-content :global(tr:last-child td) {
    border-bottom: none;
  }
  .article-content :global(blockquote) {
    border-left: 3px solid #10b981;
    padding-left: 1.25rem;
    margin-left: 0;
    margin-bottom: 1.25rem;
    color: #6b7280;
    font-style: italic;
  }
  .article-content :global(code) {
    background-color: #f3f4f6;
    padding: 0.125rem 0.375rem;
    border-radius: 0.25rem;
    font-size: 0.875rem;
    color: #1e3a8a;
    font-family: 'Courier New', monospace;
  }
  .article-content :global(a) {
    color: #1e3a8a;
    text-decoration: underline;
    text-underline-offset: 2px;
  }
  .article-content :global(a:hover) {
    color: #10b981;
  }
  .article-content :global(hr) {
    border: none;
    border-top: 1px solid #e5e7eb;
    margin: 2rem 0;
  }
</style>
