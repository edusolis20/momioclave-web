---
import { getCollection } from 'astro:content';

const casas = await getCollection('casas');
const casasOrdenadas = [...casas].sort((a, b) => b.data.rating - a.data.rating);
---

<section class="py-16 px-4 sm:px-6 lg:px-8 bg-gray-50">
  <div class="max-w-7xl mx-auto">

    <div class="max-w-2xl mb-10">
      <p class="text-emerald-600 text-sm font-semibold uppercase tracking-widest mb-2">Casas de apuestas</p>
      <h2 class="text-2xl sm:text-3xl font-bold text-gray-900 mb-3">
        Las mejores opciones en México
      </h2>
      <p class="text-gray-500 text-base">
        Evaluamos cada plataforma en base a momios, velocidad de retiro, variedad de mercados
        y experiencia de usuario. Nuestras reseñas son independientes.
      </p>
    </div>

    <div class="grid grid-cols-1 sm:grid-cols-2 lg:grid-cols-4 gap-5">
      {casasOrdenadas.map(casa => (
        <div class="bg-white rounded-2xl border border-gray-100 p-5 hover:border-blue-200 hover:shadow-md transition-all flex flex-col">

          <div class="flex items-start justify-between mb-4">
            <div
              class="w-12 h-12 rounded-xl flex items-center justify-center"
              style={`background-color: ${casa.data.logoColor}`}
            >
              <span class="text-white font-black text-lg leading-none">
                {casa.data.nombre[0]}
              </span>
            </div>
            <div class="flex items-center gap-1">
              <svg class="w-4 h-4 text-amber-400 fill-current" viewBox="0 0 20 20">
                <path d="M9.049 2.927c.3-.921 1.603-.921 1.902 0l1.07 3.292a1 1 0 00.95.69h3.462c.969 0 1.371 1.24.588 1.81l-2.8 2.034a1 1 0 00-.364 1.118l1.07 3.292c.3.921-.755 1.688-1.54 1.118l-2.8-2.034a1 1 0 00-1.175 0l-2.8 2.034c-.784.57-1.838-.197-1.539-1.118l1.07-3.292a1 1 0 00-.364-1.118L2.98 8.72c-.783-.57-.38-1.81.588-1.81h3.461a1 1 0 00.951-.69l1.07-3.292z"/>
              </svg>
              <span class="font-bold text-gray-900 text-sm">{casa.data.rating.toFixed(1)}</span>
            </div>
          </div>

          <h3 class="font-bold text-gray-900 text-base mb-1">{casa.data.nombre}</h3>
          <div class="inline-flex items-center gap-1.5 bg-emerald-50 text-emerald-700 text-xs font-semibold px-2.5 py-1 rounded-lg mb-3">
            <svg class="w-3 h-3" fill="currentColor" viewBox="0 0 20 20">
              <path fill-rule="evenodd" d="M5 5a3 3 0 015-2.236A3 3 0 0114.83 6H16a2 2 0 110 4h-5V9a1 1 0 10-2 0v1H4a2 2 0 110-4h1.17C5.06 5.687 5 5.35 5 5zm4 1V5a1 1 0 10-1 1h1zm3 0a1 1 0 10-1-1v1h1z" clip-rule="evenodd"/>
              <path d="M9 11H3v5a2 2 0 002 2h4v-7zM11 18h4a2 2 0 002-2v-5h-6v7z"/>
            </svg>
            {casa.data.bonoBienvenida}
          </div>

          <ul class="space-y-1.5 mb-4 flex-1">
            {casa.data.pros.slice(0, 2).map(pro => (
              <li class="flex items-start gap-2 text-xs text-gray-600">
                <svg class="w-3.5 h-3.5 text-emerald-500 mt-0.5 flex-shrink-0" fill="currentColor" viewBox="0 0 20 20">
                  <path fill-rule="evenodd" d="M10 18a8 8 0 100-16 8 8 0 000 16zm3.707-9.293a1 1 0 00-1.414-1.414L9 10.586 7.707 9.293a1 1 0 00-1.414 1.414l2 2a1 1 0 001.414 0l4-4z" clip-rule="evenodd"/>
                </svg>
                {pro}
              </li>
            ))}
          </ul>

          <a
            href={`/casas/${casa.slug}`}
            class="block text-center py-2.5 bg-blue-900 hover:bg-blue-800 text-white text-sm font-semibold rounded-lg transition-colors mt-auto"
          >
            Ver reseña completa
          </a>
        </div>
      ))}
    </div>

    <p class="text-center text-xs text-gray-400 mt-6">
      * Las reseñas son independientes. Puede contener enlaces de afiliados.
    </p>
  </div>
</section>
