---
import { getCollection } from 'astro:content';
import { CLUSTERS } from '../../data/articulos';

const todos = await getCollection('articulos');
const destacados = todos
  .filter(a => a.data.destacado)
  .sort((a, b) => new Date(a.data.fecha).getTime() - new Date(b.data.fecha).getTime())
  .slice(0, 3);
---

<section class="py-16 px-4 sm:px-6 lg:px-8 bg-white">
  <div class="max-w-7xl mx-auto">

    <!-- Section header -->
    <div class="max-w-2xl mb-10">
      <p class="text-emerald-600 text-sm font-semibold uppercase tracking-widest mb-2">Centro educativo</p>
      <h2 class="text-2xl sm:text-3xl font-bold text-gray-900 mb-3">
        Aprende a apostar con criterio
      </h2>
      <p class="text-gray-500 text-base">
        No publicamos pronósticos. Publicamos educación. Entender cómo funcionan los momios
        es la única ventaja real que puede tener un apostador recreativo.
      </p>
    </div>

    <!-- Article cards -->
    <div class="grid grid-cols-1 md:grid-cols-3 gap-6 mb-8">
      {destacados.map(articulo => {
        const cluster = CLUSTERS[articulo.data.cluster];
        return (
          <article class="group bg-white border border-gray-100 rounded-2xl p-6 hover:border-blue-200 hover:shadow-md transition-all">
            <div class="inline-flex items-center gap-1.5 bg-gray-50 px-3 py-1 rounded-full text-xs font-semibold text-gray-600 mb-4">
              <span>{cluster.icono}</span>
              {cluster.nombre}
            </div>
            <h3 class="font-bold text-gray-900 text-base leading-snug mb-2 group-hover:text-blue-900 transition-colors">
              {articulo.data.titulo}
            </h3>
            <p class="text-gray-500 text-sm leading-relaxed mb-4">
              {articulo.data.descripcion}
            </p>
            <div class="flex items-center justify-between pt-3 border-t border-gray-50">
              <span class="text-xs text-gray-400">{articulo.data.tiempoLectura} min de lectura</span>
              <a
                href={`/aprende/${articulo.slug}`}
                class="text-xs font-semibold text-blue-900 hover:text-emerald-600 transition-colors inline-flex items-center gap-1"
              >
                Leer artículo
                <svg class="w-3 h-3" fill="none" stroke="currentColor" viewBox="0 0 24 24">
                  <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M9 5l7 7-7 7"/>
                </svg>
              </a>
            </div>
          </article>
        );
      })}
    </div>

    <div class="text-center">
      <a
        href="/aprende"
        class="inline-flex items-center gap-2 px-6 py-3 bg-blue-900 hover:bg-blue-800 text-white font-semibold rounded-xl transition-colors text-sm"
      >
        Ver todos los artículos
        <svg class="w-4 h-4" fill="none" stroke="currentColor" viewBox="0 0 24 24">
          <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M9 5l7 7-7 7"/>
        </svg>
      </a>
    </div>
  </div>
</section>
